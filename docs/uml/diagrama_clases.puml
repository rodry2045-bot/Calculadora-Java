@startuml diagrama_clases
' Diagrama de clases - Calculadora de Cálculo con Asistente de IA
' Visualícelo en https://www.plantuml.com/plantuml o con la extensión PlantUML de VS Code / IntelliJ.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package calculadora {
  class Main {
    +{static} main(args : String[])
  }
}

package calculadora.modelo {
  enum Variable {
    X
    Y
    U
    THETA
    +getSimbolo() : String
    +otra() : Variable
  }
  interface Graficable {
    +evaluarEn(v, valor, otra) : double
    +dependeDe(v) : boolean
  }
  enum MetodoCalculo {
    +getCategoria() : Categoria
    +getOperacion() : Operacion
    +getReglas() : ReglaCalculo[]
  }
  class EntradaCalculo {
    -expresion : String
    -funcionG : String
    -variable : Variable
    -limiteA : String
    -limiteB : String
    -punto : String
  }
  class ResultadoCalculo {
    -tipo : TipoOperacion
    -pasosDetallados : List<PasoDetallado>
    -notas : List<String>
    -textoResultado : String
    -valorNumerico : Double
    -puntosMarcados : List<double[]>
  }
  class PasoDetallado
  enum ReglaCalculo
  class Calculadora <<Fachada>> {
    +resolver(metodo, entrada) : ResultadoCalculo
    +interpretar(texto) : Nodo
  }
}

package calculadora.simbolico {
  abstract class Nodo <<Composite>> {
    +{abstract} evaluar(x, y) : double
    +{abstract} clave() : String
    +{abstract} reemplazar(objetivo, nuevo) : Nodo
  }
  class NodoConstante
  class NodoVariable
  abstract class NodoBinario
  class NodoSuma
  class NodoResta
  class NodoProducto
  class NodoCociente
  class NodoPotencia
  class NodoNegativo
  class NodoFuncion
  enum TipoFuncion

  class AnalizadorSimbolico {
    +analizar(texto) : Nodo
    +getAvisos() : List<String>
    +analizarLimite(texto) : double
  }
  class Sugeridor <<utilidad>> {
    +{static} sugerir(texto) : String
  }
  class Simplificador <<utilidad>>
  class Embellecedor <<utilidad>>
  class Derivador {
    +derivar(f, v) : Nodo
  }
  class Integrador {
    +integrar(f, v, tecnica) : Nodo
    +{static} verificar(F, f, v) : boolean
  }
  class IntegradorRacional
  class IntegradorTrigonometrico
  class IntegracionNumerica <<Gauss-Kronrod>> {
    +{static} integrar(f, v, a, b, otra) : Resultado
  }
  class Limites <<utilidad>>
  class BuscadorRaices <<utilidad>>
  class Polinomio
  class RegistroPasos
  class MotorSimbolico <<Fachada>> {
    +resolver(metodo, entrada) : ResultadoCalculo
  }
}

package calculadora.excepciones {
  class CalculadoraException
  class ExpresionInvalidaException
  class OperacionNoSoportadaException
  class DominioInvalidoException
  class IAException
}

package calculadora.util {
  class FormatoNumeros <<utilidad>>
  class JsonSencillo <<utilidad>>
}

package calculadora.ia {
  interface ProveedorIA {
    +getNombre() : String
    +generarRespuesta(sistema, mensaje) : String
  }
  class ProveedorAnthropic
  class ProveedorCompatibleOpenAI
  class ConfiguracionIA
  class ExplicadorLocal
  class TutorIA {
    +explicar(resultado, pregunta) : String
  }
}

package calculadora.vista {
  class VentanaCalculadora
  class PanelMetodos
  class VistaFormula
  class PanelGrafico2D
  class Historial
  class ExportadorProcedimiento
  class RenderizadorHtml
}

package calculadora.pruebas {
  class PruebasCalculadora
}

Graficable <|.. Nodo
Nodo <|-- NodoConstante
Nodo <|-- NodoVariable
Nodo <|-- NodoBinario
Nodo <|-- NodoNegativo
Nodo <|-- NodoFuncion
NodoBinario <|-- NodoSuma
NodoBinario <|-- NodoResta
NodoBinario <|-- NodoProducto
NodoBinario <|-- NodoCociente
NodoBinario <|-- NodoPotencia
NodoFuncion --> TipoFuncion

Calculadora --> MotorSimbolico
MotorSimbolico --> AnalizadorSimbolico
MotorSimbolico ..> Derivador
MotorSimbolico ..> Integrador
MotorSimbolico ..> IntegracionNumerica
MotorSimbolico ..> Limites
MotorSimbolico ..> BuscadorRaices
MotorSimbolico ..> Embellecedor
MotorSimbolico ..> ResultadoCalculo : crea
Integrador ..> IntegradorRacional
Integrador ..> IntegradorTrigonometrico
Integrador ..> Polinomio
Derivador --> RegistroPasos
Integrador --> RegistroPasos
AnalizadorSimbolico ..> Nodo : crea
Sugeridor ..> AnalizadorSimbolico
ResultadoCalculo o-- "0..*" PasoDetallado
PasoDetallado --> ReglaCalculo
MetodoCalculo --> ReglaCalculo

CalculadoraException <|-- ExpresionInvalidaException
CalculadoraException <|-- OperacionNoSoportadaException
CalculadoraException <|-- DominioInvalidoException
CalculadoraException <|-- IAException

ProveedorIA <|.. ProveedorAnthropic
ProveedorIA <|.. ProveedorCompatibleOpenAI
TutorIA --> ProveedorIA
TutorIA --> ExplicadorLocal
TutorIA --> ConfiguracionIA
ProveedorAnthropic ..> JsonSencillo
ProveedorCompatibleOpenAI ..> JsonSencillo

Main ..> VentanaCalculadora
VentanaCalculadora --> Calculadora
VentanaCalculadora --> TutorIA
VentanaCalculadora *-- PanelMetodos
VentanaCalculadora *-- VistaFormula
VentanaCalculadora *-- PanelGrafico2D
VentanaCalculadora --> Historial
VentanaCalculadora ..> ExportadorProcedimiento
VentanaCalculadora ..> Sugeridor
VentanaCalculadora ..> RenderizadorHtml
PruebasCalculadora ..> Calculadora
@enduml
