@startuml secuencia_integral_definida
' Secuencia: el usuario calcula una integral definida y pide la explicación a la IA
actor Estudiante
participant VentanaCalculadora as V
participant Calculadora as C
participant MotorSimbolico as M
participant AnalizadorSimbolico as A
participant Integrador as I
participant IntegracionNumerica as N
participant PanelGrafico2D as G
participant "SwingWorker" as W
participant TutorIA as IA
participant ProveedorIA as P
participant ExplicadorLocal as L

Estudiante -> V : escribe f (la vista previa\nmuestra cómo se entendió)
Estudiante -> V : elige "Definida [a, b]", a, b\ny pulsa Calcular
V -> C : resolver(método, entrada)
C -> M : resolver(método, entrada)
M -> A : analizar(texto)
A --> M : árbol (Nodo) + avisos de lectura
M -> I : integrar(f, v, técnica)
alt se encuentra la antiderivada
  I -> I : verificar(F, f): d/dx F = f
  I --> M : F
  M -> M : F(b) - F(a) (con límites laterales\nsi es impropia)
  M -> N : integrar(f, a, b)
  N --> M : comprobación numérica
else no tiene antiderivada elemental
  I --> M : OperacionNoSoportadaException
  M -> N : integrar(f, a, b) (Gauss-Kronrod)
  N --> M : valor aproximado
end
M --> V : ResultadoCalculo (pasos, notas, resultado)
V -> G : graficar(f) + sombrearArea(a, b)

Estudiante -> V : pulsa "Explicar con IA"
V -> W : execute()
W -> IA : explicar(resultado, pregunta)
alt hay proveedor y red
  IA -> P : generarRespuesta(instrucción, pasos)
  P --> IA : texto
else sin clave / sin red / error
  IA -> L : explicar(resultado, pregunta)
  L --> IA : texto local
end
IA --> W : explicación (≤ 250 palabras)
W --> V : done() en el hilo de Swing
V --> Estudiante : muestra la explicación
@enduml
